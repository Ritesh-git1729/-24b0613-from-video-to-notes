from transformers import pipeline

summarizer = pipeline(
    "summarization",
    model="facebook/bart-large-cnn"
)

def chunk_text(text, chunk_size=1200, overlap=150):
    chunks = []
    start = 0
    while start < len(text):
        end = start + chunk_size
        chunks.append(text[start:end])
        start = end - overlap
    return chunks

def summarize_chunk(chunk, max_length=150, min_length=60):
    summary = summarizer(
        chunk,
        max_length=max_length,
        min_length=min_length,
        do_sample=False
    )
    return summary[0]["summary_text"]

def final_summarize(chunks):
    intermediate_summaries = []
    for chunk in chunks:
        intermediate_summaries.append(summarize_chunk(chunk))

    merged_text = " ".join(intermediate_summaries)

    final_summary = summarizer(
        merged_text,
        max_length=200,
        min_length=100,
        do_sample=False
    )[0]["summary_text"]

    return intermediate_summaries, final_summary
